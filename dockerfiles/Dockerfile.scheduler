# Scheduler Service - 크론 작업 및 파이프라인 관리
FROM python:3.11-slim

WORKDIR /app

# 시스템 의존성 설치 (cron, docker, timezone 포함)
RUN apt-get update && apt-get install -y \
    cron \
    curl \
    wget \
    unzip \
    gnupg \
    ca-certificates \
    tzdata \
    apt-transport-https \
    lsb-release \
    && rm -rf /var/lib/apt/lists/*

# Docker CLI 설치
RUN curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null \
    && apt-get update \
    && apt-get install -y docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

# Docker Compose 설치
RUN curl -L "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose \
    && chmod +x /usr/local/bin/docker-compose

# 타임존 설정 (한국 시간)
ENV TZ=Asia/Seoul
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Chrome + ChromeDriver 설치 (키워드 수집용)
RUN wget -q -O - https://dl.google.com/linux/linux_signing_key.pub | apt-key add - \
    && echo "deb [arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main" >> /etc/apt/sources.list.d/google.list \
    && apt-get update \
    && apt-get install -y google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*

# Python 의존성 설치
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 추가 의존성 (모든 서비스용)
RUN pip install --no-cache-dir \
    selenium>=4.0.0 \
    webdriver-manager>=3.8.0 \
    google-generativeai>=0.8.0 \
    firebase-admin>=6.9.0 \
    requests>=2.31.0

# 소스 코드 복사
COPY trend-collector/ ./trend-collector/
COPY trend-analyzer/ ./trend-analyzer/
COPY library-searcher/ ./library-searcher/
COPY scheduler/ ./scheduler/
COPY csproject2025-cfcb7-firebase-adminsdk-fbsvc-6764c4a1fb.json /app/csproject2025-cfcb7-firebase-adminsdk-fbsvc-6764c4a1fb.json

# 로그 디렉토리 생성
RUN mkdir -p /var/log

# cron 작업 등록 (환경변수 포함) - 한국 시간 기준 오후 3시 (15:00)
RUN echo "# 환경변수 설정" > /etc/cron.d/daily-pipeline && \
    echo "TZ=Asia/Seoul" >> /etc/cron.d/daily-pipeline && \
    echo "GEMINI_API_KEY=AIzaSyD1hxIJlbglSksUxRyLZkMZHrWyqFEwpEs" >> /etc/cron.d/daily-pipeline && \
    echo "NAVER_CLIENT_ID=RPUhkWY7UVq81hlMiHNL" >> /etc/cron.d/daily-pipeline && \
    echo "NAVER_CLIENT_SECRET=u5HUugAYuv" >> /etc/cron.d/daily-pipeline && \
    echo "PYTHONPATH=/app" >> /etc/cron.d/daily-pipeline && \
    echo "PYTHONUNBUFFERED=1" >> /etc/cron.d/daily-pipeline && \
    echo "PATH=/usr/local/bin:/usr/bin:/bin" >> /etc/cron.d/daily-pipeline && \
    echo "" >> /etc/cron.d/daily-pipeline && \
    echo "# 매일 한국시간 오후 3시(15:00)에 파이프라인 실행" >> /etc/cron.d/daily-pipeline && \
    echo "05 18 * * * root cd /app && /app/scheduler/docker_pipeline_runner.sh >> /var/log/pipeline.log 2>&1" >> /etc/cron.d/daily-pipeline && \
    echo "" >> /etc/cron.d/daily-pipeline

# cron 작업 권한 설정
RUN chmod 0644 /etc/cron.d/daily-pipeline

# crontab 등록
RUN crontab /etc/cron.d/daily-pipeline

# 환경변수 설정
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV TZ=Asia/Seoul

# 시작 스크립트 생성
RUN echo '#!/bin/bash' > /app/start_scheduler.sh && \
    echo 'echo "🕐 스케줄러 시작 - 매일 한국시간 오후 3시(15:00)에 파이프라인 실행"' >> /app/start_scheduler.sh && \
    echo 'echo "📁 로그 위치: /var/log/pipeline.log"' >> /app/start_scheduler.sh && \
    echo 'echo "⏰ 현재 시간: $(date)"' >> /app/start_scheduler.sh && \
    echo 'echo "🌏 타임존: $TZ"' >> /app/start_scheduler.sh && \
    echo 'echo "🐳 Docker 버전: $(docker --version 2>/dev/null || echo "Docker not available")"' >> /app/start_scheduler.sh && \
    echo 'echo "📋 크론 작업:"' >> /app/start_scheduler.sh && \
    echo 'crontab -l' >> /app/start_scheduler.sh && \
    echo '' >> /app/start_scheduler.sh && \
    echo '# cron 서비스 시작' >> /app/start_scheduler.sh && \
    echo 'service cron start' >> /app/start_scheduler.sh && \
    echo '' >> /app/start_scheduler.sh && \
    echo '# 크론 로그 활성화' >> /app/start_scheduler.sh && \
    echo 'touch /var/log/cron.log' >> /app/start_scheduler.sh && \
    echo '' >> /app/start_scheduler.sh && \
    echo '# 무한 대기 (컨테이너 유지)' >> /app/start_scheduler.sh && \
    echo 'tail -f /dev/null' >> /app/start_scheduler.sh

RUN chmod +x /app/start_scheduler.sh

# 실행 명령
CMD ["/app/start_scheduler.sh"]