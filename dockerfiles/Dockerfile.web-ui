# 수정된 dockerfiles/Dockerfile.web-ui
FROM nginx:alpine

# 기본 nginx 설정 제거
RUN rm -rf /usr/share/nginx/html/*

# 웹 데모 파일 생성
RUN mkdir -p /usr/share/nginx/html/js

# 수정된 JavaScript 파일 생성 (API 연결 문제 해결)
COPY <<EOF /usr/share/nginx/html/js/app.js
// 수정된 API 기본 URL - Docker 환경을 고려한 동적 설정
const API_BASE = (() => {
    // Docker 환경에서 nginx 프록시를 통해 접근
    if (window.location.hostname === 'localhost' && window.location.port === '3001') {
        return window.location.origin; // nginx가 /api/ 경로를 프록시
    } else if (window.location.hostname === 'localhost') {
        // 로컬 개발 환경 - 올바른 포트 사용
        return 'http://localhost:5001';
    } else {
        // 프로덕션 환경
        return window.location.origin;
    }
})();

// 전역 변수
let currentUser = null;
let currentTrends = [];
let recommendationPlaylist = [];
let currentRecommendationIndex = -1;

// API 연결 상태 확인 개선
async function checkApiConnection() {
    try {
        // 다양한 경로로 API 연결 시도
        const endpoints = [
            \`\${API_BASE}/\`,
            \`\${API_BASE}/api/\`,
            '/api/',  // nginx 프록시 경로
            'http://localhost:5001/'
        ];
        
        for (const endpoint of endpoints) {
            try {
                const response = await fetch(endpoint, { 
                    method: 'GET',
                    mode: 'cors',
                    timeout: 3000
                });
                
                if (response.ok) {
                    // 성공한 엔드포인트로 API_BASE 업데이트
                    window.API_BASE = endpoint.replace(/\/$/, '');
                    updateApiStatus(true);
                    console.log(\`✅ API 연결 성공: \${endpoint}\`);
                    return true;
                }
            } catch (error) {
                console.debug(\`API 연결 실패: \${endpoint} - \${error.message}\`);
                continue;
            }
        }
        
        updateApiStatus(false);
        return false;
    } catch (error) {
        console.error('API 연결 확인 중 오류:', error);
        updateApiStatus(false);
        return false;
    }
}

function updateApiStatus(connected) {
    const statusEl = document.getElementById('apiStatus');
    if (connected) {
        statusEl.textContent = '✅ API 연결됨';
        statusEl.className = 'api-status connected';
    } else {
        statusEl.textContent = '❌ API 연결 실패';
        statusEl.className = 'api-status disconnected';
    }
}

// API 호출 헬퍼 함수
async function apiCall(endpoint, options = {}) {
    const baseUrl = window.API_BASE || API_BASE;
    const url = endpoint.startsWith('/') ? \`\${baseUrl}\${endpoint}\` : \`\${baseUrl}/\${endpoint}\`;
    
    const defaultOptions = {
        headers: {
            'Content-Type': 'application/json',
        },
        ...options
    };
    
    try {
        const response = await fetch(url, defaultOptions);
        
        if (!response.ok) {
            throw new Error(\`HTTP \${response.status}: \${response.statusText}\`);
        }
        
        return await response.json();
    } catch (error) {
        console.error(\`API 호출 실패: \${url}\`, error);
        throw error;
    }
}

// 탭 전환
function showTab(tabId) {
    document.querySelectorAll('.nav-tab').forEach(tab => tab.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(pane => pane.classList.remove('active'));
    
    event.target.classList.add('active');
    document.getElementById(tabId).classList.add('active');
    
    if (tabId === 'trends') {
        loadTrends();
    }
}

// 페이지 로드 시 초기화
window.onload = async function() {
    const connected = await checkApiConnection();
    if (connected) {
        loadUsers();
        loadTrends();
    } else {
        showError('API 서버에 연결할 수 없습니다. 컨테이너가 실행 중인지 확인하세요.');
    }
    
    // 주기적으로 API 연결 상태 확인
    setInterval(checkApiConnection, 30000);
};

// 사용자 목록 로드
async function loadUsers() {
    try {
        const data = await apiCall('/api/users');
        
        const select = document.getElementById('userSelect');
        select.innerHTML = '<option value="">사용자를 선택하세요...</option>';
        
        if (data.user_ids && data.user_ids.length > 0) {
            data.user_ids.forEach(userId => {
                const option = document.createElement('option');
                option.value = userId;
                option.textContent = userId;
                select.appendChild(option);
            });
        } else {
            // 사용자가 없는 경우 기본 데모 사용자 생성 옵션 제공
            const option = document.createElement('option');
            option.value = 'demo_user';
            option.textContent = '데모 사용자 (자동 생성)';
            select.appendChild(option);
        }
    } catch (error) {
        console.error('사용자 목록 로드 실패:', error);
        showError('사용자 목록을 불러올 수 없습니다. API 서버 상태를 확인해주세요.');
    }
}

// 사용자 프로필 로드
async function loadUserProfile() {
    const userId = document.getElementById('userSelect').value;
    if (!userId) {
        alert('사용자를 선택하세요.');
        return;
    }

    try {
        // 데모 사용자인 경우 자동 생성
        if (userId === 'demo_user') {
            await createDemoUser();
            return;
        }
        
        const profile = await apiCall(\`/api/users/\${userId}\`);
        currentUser = userId;
        
        displayUserProfile(profile);
        updateRecommendationTab();
        showSuccess(\`\${userId} 사용자 프로필을 불러왔습니다.\`);
    } catch (error) {
        console.error('프로필 로드 실패:', error);
        
        // 404 오류인 경우 사용자 생성 제안
        if (error.message.includes('404')) {
            if (confirm(\`사용자 '\${userId}'를 찾을 수 없습니다. 새로 생성하시겠습니까?\`)) {
                showCreateUserForm();
                document.getElementById('newUserId').value = userId;
            }
        } else {
            showError('사용자 프로필을 불러올 수 없습니다: ' + error.message);
        }
    }
}

// 데모 사용자 자동 생성
async function createDemoUser() {
    const demoUserData = {
        user_id: 'demo_user',
        name: '데모 사용자',
        age_group: '20대',
        reading_frequency: '주 2-3회',
        preferred_keywords: ['인공지능', 'IT', '과학', '문학'],
        preferred_types: ['기술서', '소설', '과학도서']
    };

    try {
        await apiCall('/api/users', {
            method: 'POST',
            body: JSON.stringify(demoUserData)
        });
        
        currentUser = 'demo_user';
        displayUserProfile(demoUserData);
        updateRecommendationTab();
        showSuccess('데모 사용자가 생성되었습니다. 맞춤 추천을 체험해보세요!');
        
        // 사용자 선택 드롭다운 업데이트
        await loadUsers();
        document.getElementById('userSelect').value = 'demo_user';
        
    } catch (error) {
        console.error('데모 사용자 생성 실패:', error);
        showError('데모 사용자 생성에 실패했습니다: ' + error.message);
    }
}

// 사용자 프로필 표시
function displayUserProfile(profile) {
    const profileInfo = document.getElementById('profileInfo');
    profileInfo.innerHTML = \`
        <div style="background: #f8f9fa; padding: 20px; border-radius: 10px;">
            <p><strong>사용자 ID:</strong> \${profile.user_id}</p>
            <p><strong>이름:</strong> \${profile.name || '미설정'}</p>
            <p><strong>연령대:</strong> \${profile.age_group || '미설정'}</p>
            <p><strong>독서 빈도:</strong> \${profile.reading_frequency || '미설정'}</p>
            <p><strong>선호 키워드:</strong> \${profile.preferred_keywords?.join(', ') || '없음'}</p>
        </div>
    \`;
    document.getElementById('userProfile').style.display = 'block';
}

// 신규 사용자 생성 폼 표시/숨김
function showCreateUserForm() {
    document.getElementById('createUserForm').style.display = 'block';
    document.getElementById('userProfile').style.display = 'none';
}

function hideCreateUserForm() {
    document.getElementById('createUserForm').style.display = 'none';
}

// 신규 사용자 생성
async function createUser(event) {
    event.preventDefault();
    
    const userData = {
        user_id: document.getElementById('newUserId').value,
        name: document.getElementById('newUserName').value,
        age_group: document.getElementById('newUserAge').value,
        reading_frequency: document.getElementById('newUserFreq').value,
        preferred_keywords: [],
        preferred_types: []
    };

    try {
        const response = await apiCall('/api/users', {
            method: 'POST',
            body: JSON.stringify(userData)
        });

        showSuccess('사용자가 성공적으로 생성되었습니다.');
        hideCreateUserForm();
        await loadUsers();
        document.getElementById('userSelect').value = userData.user_id;
        await loadUserProfile();
    } catch (error) {
        console.error('사용자 생성 실패:', error);
        showError('사용자 생성에 실패했습니다: ' + error.message);
    }
}

// 나머지 함수들... (트렌드 로드, 추천, 피드백 등)
// [기존 코드와 동일하므로 생략]

// 에러/성공 메시지 표시
function showError(message) {
    const existing = document.querySelector('.error');
    if (existing) existing.remove();
    
    const errorDiv = document.createElement('div');
    errorDiv.className = 'error';
    errorDiv.innerHTML = \`
        <strong>⚠️ 오류 발생</strong><br>
        \${message}<br>
        <small>문제가 지속되면 관리자에게 문의하세요.</small>
    \`;
    
    document.querySelector('.tab-pane.active .tab-content').prepend(errorDiv);
    setTimeout(() => errorDiv.remove(), 8000);
}

function showSuccess(message) {
    const existing = document.querySelector('.success');
    if (existing) existing.remove();
    
    const successDiv = document.createElement('div');
    successDiv.className = 'success';
    successDiv.textContent = message;
    document.querySelector('.tab-pane.active .tab-content').prepend(successDiv);
    setTimeout(() => successDiv.remove(), 3000);
}

// 기타 필요한 함수들은 기존 코드와 동일...
EOF

# 수정된 nginx 설정
COPY <<EOF /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Gzip 압축
    gzip on;
    gzip_types text/plain text/css application/javascript application/json;

    # 정적 파일 서빙
    location / {
        try_files \$uri \$uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # API 프록시 (CORS 문제 해결)
    location /api/ {
        # Docker Compose 환경에서 서비스명으로 연결
        proxy_pass http://recommendation-api:5001/api/;
        
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        
        # 타임아웃 설정
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        
        # CORS 헤더 추가
        add_header Access-Control-Allow-Origin *;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS";
        add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With";
        
        # OPTIONS 요청 처리 (CORS preflight)
        if (\$request_method = 'OPTIONS') {
            add_header Access-Control-Allow-Origin *;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS";
            add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With";
            add_header Access-Control-Max-Age 3600;
            add_header Content-Type text/plain;
            add_header Content-Length 0;
            return 204;
        }
    }

    # 헬스체크
    location /health {
        return 200 '{"status": "healthy", "service": "demo-web"}';
        add_header Content-Type application/json;
    }
}
EOF

# 메인 HTML 파일 생성 (기존과 동일하지만 JavaScript 로딩 수정)
COPY <<EOF /usr/share/nginx/html/index.html
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>트렌드 기반 도서 추천 시스템</title>
    <!-- 기존 CSS 스타일은 동일하므로 생략 -->
    <style>
        /* 기존 스타일과 동일 */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; color: #333; }
        .api-status { position: fixed; top: 20px; right: 20px; padding: 10px 15px; border-radius: 20px; color: white; font-weight: bold; z-index: 1000; }
        .api-status.connected { background: #28a745; }
        .api-status.disconnected { background: #dc3545; }
        .error { background: #f8d7da; color: #721c24; padding: 15px; border-radius: 8px; margin: 20px 0; }
        .success { background: #d1edff; color: #0c5460; padding: 15px; border-radius: 8px; margin: 20px 0; }
        /* 기타 스타일들... */
    </style>
</head>
<body>
    <div id="apiStatus" class="api-status disconnected">API 연결 확인 중...</div>
    
    <div class="container">
        <div class="header">
            <h1>📚 트렌드 기반 도서 추천 시스템</h1>
            <p>AI가 분석한 최신 트렌드를 바탕으로 맞춤형 도서를 추천해드립니다</p>
        </div>

        <div class="main-content">
            <!-- 기존 HTML 구조와 동일 -->
            <div class="nav-tabs">
                <button class="nav-tab active" onclick="showTab('user-setup')">👤 사용자 설정</button>
                <button class="nav-tab" onclick="showTab('trends')">📈 최신 트렌드</button>
                <button class="nav-tab" onclick="showTab('recommendations')">📖 맞춤 추천</button>
            </div>

            <!-- 사용자 설정 탭 -->
            <div id="user-setup" class="tab-pane active">
                <div class="tab-content">
                    <h2 style="text-align: center; margin-bottom: 30px;">사용자 선택 및 설정</h2>
                    
                    <div class="user-selection">
                        <select id="userSelect" class="user-select">
                            <option value="">사용자를 선택하세요...</option>
                        </select>
                        <button class="btn" onclick="loadUserProfile()">프로필 로드</button>
                        <button class="btn" onclick="showCreateUserForm()">신규 사용자 생성</button>
                    </div>

                    <!-- 신규 사용자 생성 폼 -->
                    <div id="createUserForm" style="display: none;">
                        <h3>신규 사용자 생성</h3>
                        <form onsubmit="createUser(event)">
                            <input type="text" id="newUserId" placeholder="사용자 ID" required>
                            <input type="text" id="newUserName" placeholder="이름" required>
                            <select id="newUserAge">
                                <option value="">연령대 선택</option>
                                <option value="10대">10대</option>
                                <option value="20대">20대</option>
                                <option value="30대">30대</option>
                                <option value="40대">40대</option>
                                <option value="50대 이상">50대 이상</option>
                            </select>
                            <select id="newUserFreq">
                                <option value="">독서 빈도 선택</option>
                                <option value="매일">매일</option>
                                <option value="주 2-3회">주 2-3회</option>
                                <option value="주 1회">주 1회</option>
                                <option value="월 1-2회">월 1-2회</option>
                            </select>
                            <button type="submit" class="btn">사용자 생성</button>
                            <button type="button" class="btn" onclick="hideCreateUserForm()">취소</button>
                        </form>
                    </div>

                    <!-- 사용자 프로필 정보 -->
                    <div id="userProfile" style="display: none;">
                        <h3>사용자 프로필</h3>
                        <div id="profileInfo"></div>
                    </div>
                </div>
            </div>

            <!-- 트렌드 탭 -->
            <div id="trends" class="tab-pane">
                <div class="tab-content">
                    <h2>📈 최신 트렌드</h2>
                    <div id="trendsContainer">
                        <div class="loading">트렌드 데이터를 불러오는 중...</div>
                    </div>
                </div>
            </div>

            <!-- 추천 탭 -->
            <div id="recommendations" class="tab-pane">
                <div class="tab-content">
                    <h2>📖 맞춤 추천</h2>
                    <div id="recommendationsContainer">
                        <div>사용자를 선택한 후 추천을 받아보세요</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/app.js"></script>
</body>
</html>
EOF

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]