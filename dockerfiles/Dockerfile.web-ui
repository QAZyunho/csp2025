# 데모 웹 UI - Nginx로 정적 서빙
FROM nginx:alpine

# 기본 nginx 설정 제거
RUN rm -rf /usr/share/nginx/html/*

# 웹 데모 파일 생성
RUN mkdir -p /usr/share/nginx/html

# 메인 HTML 파일 생성
COPY <<EOF /usr/share/nginx/html/index.html
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>트렌드 기반 도서 추천 시스템</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            color: #333;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .header {
            text-align: center;
            color: white;
            margin-bottom: 30px;
            padding: 20px;
        }

        .header h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .header p {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        .main-content {
            background: white;
            border-radius: 15px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            overflow: hidden;
        }

        .nav-tabs {
            display: flex;
            background: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
        }

        .nav-tab {
            flex: 1;
            padding: 15px 20px;
            background: none;
            border: none;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 500;
            transition: all 0.3s ease;
            position: relative;
        }

        .nav-tab:hover {
            background: #e9ecef;
        }

        .nav-tab.active {
            background: white;
            color: #667eea;
        }

        .nav-tab.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: #667eea;
        }

        .tab-content {
            padding: 30px;
            min-height: 600px;
        }

        .tab-pane {
            display: none;
            animation: fadeIn 0.3s ease;
        }

        .tab-pane.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .user-selection {
            text-align: center;
            margin-bottom: 30px;
        }

        .user-select {
            padding: 12px 20px;
            font-size: 1rem;
            border: 2px solid #667eea;
            border-radius: 8px;
            margin: 0 10px;
            min-width: 200px;
        }

        .btn {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border: none;
            padding: 12px 24px;
            font-size: 1rem;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            margin: 5px;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
        }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .trend-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .trend-card {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            border-left: 4px solid #667eea;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .trend-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            border-left-color: #764ba2;
        }

        .trend-keyword {
            font-size: 1.3rem;
            font-weight: bold;
            color: #667eea;
            margin-bottom: 10px;
        }

        .trend-summary {
            color: #666;
            line-height: 1.5;
        }

        .book-grid {
            display: grid;
            gap: 15px;
            margin-top: 20px;
        }

        .book-card {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            transition: all 0.3s ease;
            border: 1px solid #e9ecef;
        }

        .book-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .book-title {
            font-size: 1.2rem;
            font-weight: bold;
            color: #333;
            margin-bottom: 8px;
        }

        .book-author {
            color: #666;
            margin-bottom: 5px;
        }

        .book-meta {
            display: flex;
            justify-content: space-between;
            font-size: 0.9rem;
            color: #999;
            margin-bottom: 15px;
        }

        .rating-stars {
            display: flex;
            gap: 5px;
            justify-content: center;
            margin-top: 15px;
        }

        .star {
            font-size: 1.5rem;
            cursor: pointer;
            color: #ddd;
            transition: color 0.2s ease;
        }

        .star:hover,
        .star.active {
            color: #ffc107;
        }

        .loading {
            text-align: center;
            padding: 40px;
            color: #666;
        }

        .error {
            background: #f8d7da;
            color: #721c24;
            padding: 15px;
            border-radius: 8px;
            margin: 20px 0;
        }

        .success {
            background: #d1edff;
            color: #0c5460;
            padding: 15px;
            border-radius: 8px;
            margin: 20px 0;
        }

        .navigation {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 20px 0;
        }

        .category-title {
            font-size: 1.4rem;
            font-weight: bold;
            color: #667eea;
            text-align: center;
        }

        .api-status {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 10px 15px;
            border-radius: 20px;
            color: white;
            font-weight: bold;
            z-index: 1000;
        }

        .api-status.connected {
            background: #28a745;
        }

        .api-status.disconnected {
            background: #dc3545;
        }
    </style>
</head>
<body>
    <div id="apiStatus" class="api-status disconnected">API 연결 확인 중...</div>
    
    <div class="container">
        <div class="header">
            <h1>📚 트렌드 기반 도서 추천 시스템</h1>
            <p>AI가 분석한 최신 트렌드를 바탕으로 맞춤형 도서를 추천해드립니다</p>
        </div>

        <div class="main-content">
            <div class="nav-tabs">
                <button class="nav-tab active" onclick="showTab('user-setup')">👤 사용자 설정</button>
                <button class="nav-tab" onclick="showTab('trends')">📈 최신 트렌드</button>
                <button class="nav-tab" onclick="showTab('recommendations')">📖 맞춤 추천</button>
            </div>

            <!-- 사용자 설정 탭 -->
            <div id="user-setup" class="tab-pane active">
                <div class="tab-content">
                    <h2 style="text-align: center; margin-bottom: 30px;">사용자 선택 및 설정</h2>
                    
                    <div class="user-selection">
                        <select id="userSelect" class="user-select">
                            <option value="">사용자를 선택하세요...</option>
                        </select>
                        <button class="btn" onclick="loadUserProfile()">프로필 로드</button>
                        <button class="btn" onclick="showCreateUserForm()">신규 사용자 생성</button>
                    </div>

                    <!-- 신규 사용자 생성 폼 -->
                    <div id="createUserForm" style="display: none; max-width: 500px; margin: 0 auto;">
                        <h3 style="text-align: center; margin-bottom: 20px;">신규 사용자 생성</h3>
                        <form onsubmit="createUser(event)">
                            <div style="margin-bottom: 15px;">
                                <label>사용자 ID: <input type="text" id="newUserId" required style="width: 100%; padding: 8px; margin-top: 5px;"></label>
                            </div>
                            <div style="margin-bottom: 15px;">
                                <label>이름: <input type="text" id="newUserName" required style="width: 100%; padding: 8px; margin-top: 5px;"></label>
                            </div>
                            <div style="margin-bottom: 15px;">
                                <label>연령대: 
                                    <select id="newUserAge" style="width: 100%; padding: 8px; margin-top: 5px;">
                                        <option value="">선택하세요</option>
                                        <option value="10대">10대</option>
                                        <option value="20대">20대</option>
                                        <option value="30대">30대</option>
                                        <option value="40대">40대</option>
                                        <option value="50대 이상">50대 이상</option>
                                    </select>
                                </label>
                            </div>
                            <div style="margin-bottom: 15px;">
                                <label>독서 빈도:
                                    <select id="newUserFreq" style="width: 100%; padding: 8px; margin-top: 5px;">
                                        <option value="">선택하세요</option>
                                        <option value="매일">매일</option>
                                        <option value="주 2-3회">주 2-3회</option>
                                        <option value="주 1회">주 1회</option>
                                        <option value="월 1-2회">월 1-2회</option>
                                        <option value="가끔">가끔</option>
                                    </select>
                                </label>
                            </div>
                            <div style="text-align: center;">
                                <button type="submit" class="btn">사용자 생성</button>
                                <button type="button" class="btn" onclick="hideCreateUserForm()">취소</button>
                            </div>
                        </form>
                    </div>

                    <!-- 사용자 프로필 정보 -->
                    <div id="userProfile" style="display: none;">
                        <h3 style="text-align: center; margin-bottom: 20px;">사용자 프로필</h3>
                        <div id="profileInfo" style="max-width: 400px; margin: 0 auto;"></div>
                    </div>
                </div>
            </div>

            <!-- 트렌드 탭 -->
            <div id="trends" class="tab-pane">
                <div class="tab-content">
                    <h2 style="text-align: center; margin-bottom: 30px;">📈 최신 트렌드</h2>
                    <div id="trendsContainer">
                        <div class="loading">트렌드 데이터를 불러오는 중...</div>
                    </div>
                </div>
            </div>

            <!-- 추천 탭 -->
            <div id="recommendations" class="tab-pane">
                <div class="tab-content">
                    <div class="navigation">
                        <button class="btn" onclick="previousRecommendation()" id="prevBtn" disabled>⬅️ 이전</button>
                        <div class="category-title" id="categoryTitle">사용자를 먼저 선택하세요</div>
                        <button class="btn" onclick="nextRecommendation()" id="nextBtn" disabled>다음 ➡️</button>
                    </div>
                    
                    <div id="recommendationsContainer">
                        <div style="text-align: center; padding: 40px; color: #666;">
                            사용자를 선택한 후 추천을 받아보세요
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/app.js"></script>
</body>
</html>
EOF

# JavaScript 파일 생성
RUN mkdir -p /usr/share/nginx/html/js

COPY <<EOF /usr/share/nginx/html/js/app.js
// API 기본 URL - 도커 환경에 맞게 설정
const API_BASE = 'http://localhost:8001';

// 전역 변수
let currentUser = null;
let currentTrends = [];
let recommendationPlaylist = [];
let currentRecommendationIndex = -1;

// API 연결 상태 확인
async function checkApiConnection() {
    try {
        const response = await fetch(\`\${API_BASE}/\`, { 
            method: 'GET',
            mode: 'cors'
        });
        if (response.ok) {
            updateApiStatus(true);
            return true;
        }
    } catch (error) {
        console.log('API 연결 실패:', error);
    }
    updateApiStatus(false);
    return false;
}

function updateApiStatus(connected) {
    const statusEl = document.getElementById('apiStatus');
    if (connected) {
        statusEl.textContent = '✅ API 연결됨';
        statusEl.className = 'api-status connected';
    } else {
        statusEl.textContent = '❌ API 연결 실패';
        statusEl.className = 'api-status disconnected';
    }
}

// 탭 전환
function showTab(tabId) {
    document.querySelectorAll('.nav-tab').forEach(tab => tab.classList.remove('active'));
    document.querySelectorAll('.tab-pane').forEach(pane => pane.classList.remove('active'));
    
    event.target.classList.add('active');
    document.getElementById(tabId).classList.add('active');
    
    if (tabId === 'trends') {
        loadTrends();
    }
}

// 페이지 로드 시 초기화
window.onload = async function() {
    const connected = await checkApiConnection();
    if (connected) {
        loadUsers();
        loadTrends();
    } else {
        showError('API 서버에 연결할 수 없습니다. 서버가 실행 중인지 확인하세요.');
    }
    
    // 주기적으로 API 연결 상태 확인
    setInterval(checkApiConnection, 30000);
};

// 사용자 목록 로드
async function loadUsers() {
    try {
        const response = await fetch(\`\${API_BASE}/api/users\`);
        const data = await response.json();
        
        const select = document.getElementById('userSelect');
        select.innerHTML = '<option value="">사용자를 선택하세요...</option>';
        
        data.user_ids.forEach(userId => {
            const option = document.createElement('option');
            option.value = userId;
            option.textContent = userId;
            select.appendChild(option);
        });
    } catch (error) {
        console.error('사용자 목록 로드 실패:', error);
        showError('사용자 목록을 불러올 수 없습니다.');
    }
}

// 사용자 프로필 로드
async function loadUserProfile() {
    const userId = document.getElementById('userSelect').value;
    if (!userId) {
        alert('사용자를 선택하세요.');
        return;
    }

    try {
        const response = await fetch(\`\${API_BASE}/api/users/\${userId}\`);
        if (!response.ok) {
            throw new Error('사용자 정보를 찾을 수 없습니다.');
        }
        
        const profile = await response.json();
        currentUser = userId;
        
        const profileInfo = document.getElementById('profileInfo');
        profileInfo.innerHTML = \`
            <div style="background: #f8f9fa; padding: 20px; border-radius: 10px;">
                <p><strong>사용자 ID:</strong> \${profile.user_id}</p>
                <p><strong>이름:</strong> \${profile.name || '미설정'}</p>
                <p><strong>연령대:</strong> \${profile.age_group || '미설정'}</p>
                <p><strong>독서 빈도:</strong> \${profile.reading_frequency || '미설정'}</p>
                <p><strong>선호 키워드:</strong> \${profile.preferred_keywords?.join(', ') || '없음'}</p>
            </div>
        \`;
        document.getElementById('userProfile').style.display = 'block';
        
        updateRecommendationTab();
        showSuccess(\`\${userId} 사용자 프로필을 불러왔습니다.\`);
    } catch (error) {
        console.error('프로필 로드 실패:', error);
        showError('사용자 프로필을 불러올 수 없습니다.');
    }
}

// 신규 사용자 생성 폼 표시/숨김
function showCreateUserForm() {
    document.getElementById('createUserForm').style.display = 'block';
    document.getElementById('userProfile').style.display = 'none';
}

function hideCreateUserForm() {
    document.getElementById('createUserForm').style.display = 'none';
}

// 신규 사용자 생성
async function createUser(event) {
    event.preventDefault();
    
    const userData = {
        user_id: document.getElementById('newUserId').value,
        name: document.getElementById('newUserName').value,
        age_group: document.getElementById('newUserAge').value,
        reading_frequency: document.getElementById('newUserFreq').value,
        preferred_keywords: [],
        preferred_types: []
    };

    try {
        const response = await fetch(\`\${API_BASE}/api/users\`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(userData)
        });

        if (response.ok) {
            showSuccess('사용자가 성공적으로 생성되었습니다.');
            hideCreateUserForm();
            await loadUsers();
            document.getElementById('userSelect').value = userData.user_id;
            await loadUserProfile();
        } else {
            throw new Error('사용자 생성에 실패했습니다.');
        }
    } catch (error) {
        console.error('사용자 생성 실패:', error);
        showError('사용자 생성에 실패했습니다.');
    }
}

// 트렌드 로드
async function loadTrends() {
    try {
        const response = await fetch(\`\${API_BASE}/api/trends/latest\`);
        const data = await response.json();
        currentTrends = data.trends;
        
        const container = document.getElementById('trendsContainer');
        
        if (currentTrends.length === 0) {
            container.innerHTML = '<div class="loading">표시할 트렌드가 없습니다.</div>';
            return;
        }

        container.innerHTML = \`
            <div class="trend-grid">
                \${currentTrends.map(trend => \`
                    <div class="trend-card" onclick="showTrendBooks('\${trend.keyword}')">
                        <div class="trend-keyword">\${trend.keyword}</div>
                        <div class="trend-summary">\${trend.summary || '요약 정보가 없습니다.'}</div>
                    </div>
                \`).join('')}
            </div>
        \`;
    } catch (error) {
        console.error('트렌드 로드 실패:', error);
        document.getElementById('trendsContainer').innerHTML = 
            '<div class="error">트렌드 데이터를 불러올 수 없습니다.</div>';
    }
}

// 트렌드 관련 도서 표시
async function showTrendBooks(keyword) {
    if (!currentUser) {
        alert('먼저 사용자를 선택하세요.');
        return;
    }

    showTab('recommendations');
    document.querySelector('[onclick="showTab(\\'recommendations\\')"]').click();
    
    try {
        const response = await fetch(\`\${API_BASE}/api/books/by_keyword/\${currentUser}?keyword=\${encodeURIComponent(keyword)}\`);
        const data = await response.json();
        
        document.getElementById('categoryTitle').textContent = \`트렌드: \${keyword}\`;
        displayBooks(data.books || []);
    } catch (error) {
        console.error('도서 로드 실패:', error);
        showError('도서 정보를 불러올 수 없습니다.');
    }
}

// 추천 탭 업데이트
function updateRecommendationTab() {
    if (currentUser) {
        buildRecommendationPlaylist();
    }
}

// 추천 플레이리스트 구성
async function buildRecommendationPlaylist() {
    try {
        const response = await fetch(\`\${API_BASE}/api/recommendations/general/\${currentUser}\`);
        const data = await response.json();
        
        recommendationPlaylist = [data];
        currentRecommendationIndex = 0;
        
        displayCurrentRecommendation();
        updateNavigationButtons();
    } catch (error) {
        console.error('추천 플레이리스트 구성 실패:', error);
        showError('추천 목록을 구성할 수 없습니다.');
    }
}

// 현재 추천 표시
function displayCurrentRecommendation() {
    if (currentRecommendationIndex >= 0 && currentRecommendationIndex < recommendationPlaylist.length) {
        const current = recommendationPlaylist[currentRecommendationIndex];
        document.getElementById('categoryTitle').textContent = current.category;
        displayBooks(current.books || []);
    }
}

// 이전/다음 추천
function previousRecommendation() {
    if (currentRecommendationIndex > 0) {
        currentRecommendationIndex--;
        displayCurrentRecommendation();
        updateNavigationButtons();
    }
}

function nextRecommendation() {
    if (currentRecommendationIndex < recommendationPlaylist.length - 1) {
        currentRecommendationIndex++;
        displayCurrentRecommendation();
        updateNavigationButtons();
    } else {
        buildRecommendationPlaylist();
    }
}

// 네비게이션 버튼 업데이트
function updateNavigationButtons() {
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    
    prevBtn.disabled = currentRecommendationIndex <= 0;
    nextBtn.disabled = false;
}

// 도서 목록 표시
function displayBooks(books) {
    const container = document.getElementById('recommendationsContainer');
    
    if (!books || books.length === 0) {
        container.innerHTML = '<div class="loading">추천할 도서가 없습니다.</div>';
        return;
    }

    container.innerHTML = \`
        <div class="book-grid">
            \${books.map((book, index) => \`
                <div class="book-card">
                    <div class="book-title">\${book.title || '제목 없음'}</div>
                    <div class="book-author">저자: \${book.author || '저자 미상'}</div>
                    <div class="book-meta">
                        <span>출판사: \${book.publisher || '미상'}</span>
                        <span>발행년도: \${book.pub_year || '미상'}</span>
                    </div>
                    <div class="rating-stars" data-book-index="\${index}">
                        \${[1,2,3,4,5].map(star => \`
                            <span class="star" onclick="rateBook(\${index}, \${star})">⭐</span>
                        \`).join('')}
                    </div>
                    <div style="text-align: center; margin-top: 10px; font-size: 0.9rem; color: #666;">
                        이 책에 대한 평가를 남겨주세요
                    </div>
                </div>
            \`).join('')}
        </div>
    \`;
}

// 도서 평가
async function rateBook(bookIndex, rating) {
    if (!currentUser) {
        alert('사용자가 선택되지 않았습니다.');
        return;
    }

    const current = recommendationPlaylist[currentRecommendationIndex];
    const book = current.books[bookIndex];
    
    if (!book) return;

    try {
        const response = await fetch(\`\${API_BASE}/api/feedback\`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                user_id: currentUser,
                book_id: book.doc_id || 'unknown',
                rating: rating,
                keyword: book.keyword || 'unknown'
            })
        });

        if (response.ok) {
            const stars = document.querySelectorAll(\`[data-book-index="\${bookIndex}"] .star\`);
            stars.forEach((star, index) => {
                star.classList.toggle('active', index < rating);
            });
            
            showSuccess(\`\${rating}점 평가가 등록되었습니다!\`);
            
            setTimeout(() => {
                buildRecommendationPlaylist();
            }, 1000);
        } else {
            throw new Error('평가 등록에 실패했습니다.');
        }
    } catch (error) {
        console.error('평가 등록 실패:', error);
        showError('평가를 등록할 수 없습니다.');
    }
}

// 메시지 표시 함수들
function showError(message) {
    const existing = document.querySelector('.error');
    if (existing) existing.remove();
    
    const errorDiv = document.createElement('div');
    errorDiv.className = 'error';
    errorDiv.textContent = message;
    document.querySelector('.tab-pane.active .tab-content').prepend(errorDiv);
    
    setTimeout(() => errorDiv.remove(), 5000);
}

function showSuccess(message) {
    const existing = document.querySelector('.success');
    if (existing) existing.remove();
    
    const successDiv = document.createElement('div');
    successDiv.className = 'success';
    successDiv.textContent = message;
    document.querySelector('.tab-pane.active .tab-content').prepend(successDiv);
    
    setTimeout(() => successDiv.remove(), 3000);
}
EOF

# 헬스체크 페이지 생성
COPY <<EOF /usr/share/nginx/html/health
{"status": "healthy", "service": "demo-web"}
EOF

# Nginx 설정 파일
COPY <<EOF /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Gzip 압축
    gzip on;
    gzip_types text/plain text/css application/javascript application/json;

    # 정적 파일 서빙
    location / {
        try_files \$uri \$uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # API 프록시 (CORS 문제 해결)
    location /api/ {
        proxy_pass http://recommendation-api:5001;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        
        # CORS 헤더 추가
        add_header Access-Control-Allow-Origin *;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS";
        add_header Access-Control-Allow-Headers "Content-Type, Authorization";
    }

    # 헬스체크
    location /health {
        return 200 '{"status": "healthy", "service": "demo-web"}';
        add_header Content-Type application/json;
    }
}
EOF

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]