# Trend Analyzer Service - 트렌드 분석 서비스
FROM python:3.11-slim

WORKDIR /app

# 시스템 의존성 설치
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Python 의존성 파일 복사 및 설치
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 추가 의존성 (trend-analyzer 전용)
RUN pip install --no-cache-dir \
    google-generativeai>=0.8.0 \
    firebase-admin>=6.9.0

# 소스 코드 복사
COPY trend-analyzer/ ./trend-analyzer/
COPY csproject2025-cfcb7-firebase-adminsdk-fbsvc-6764c4a1fb.json /app/csproject2025-cfcb7-firebase-adminsdk-fbsvc-6764c4a1fb.json

# 환경변수 설정
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# 실행 명령 (배치 작업)
CMD ["python", "trend-analyzer/trend_analyzer.py"]